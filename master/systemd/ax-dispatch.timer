[Unit]
Description=AX 자동 파견 따라잡기 (놓친 트리거를 되찾는다 · #340)

[Timer]
# 🔴 **왜 타이머가 또 필요한가.** ax-dispatch.path 는 신호 파일이 생길 때만 깨운다.
#    그 신호를 못 쓰는 경로가 실재한다:
#      ① 소비자가 그 배치를 아예 안 봤다 (다른 소비자가 flock 을 쥐고 있어 물러났다)
#      ② note_trigger 가 OSError 로 실패했다
#      ③ 파견이 예외로 죽어 트리거를 이미 지운 뒤였다 (drain 은 파견 **전에** 지운다 —
#         남기면 .path 가 무한 재기동하고, 여기는 **돈이 나가는 자리**다)
#    ax-indexer 가 게이트와 타이머를 짝으로 둔 것과 **같은 이유**이고, 그 교훈은
#    리포트 13 §19.3 이다: *"가드를 두고 타이머를 안 두면 갱신 주체가 아무도 없다."*
#
# 10분은 색인기 타이머와 같은 값으로 맞췄다. 파견 한 바퀴가 분 단위라 놓쳐도 10분 안에
# 따라잡고, 평시에는 멱등 가드(pending 있을 때만)에 걸려 즉시 끝난다.
OnBootSec=5min
OnUnitActiveSec=10min
RandomizedDelaySec=30s
AccuracySec=30s
Persistent=false
# 🔴 .path 가 깨우는 것과 **다른 유닛**이다 — 이쪽만 --catchup 이 붙는다.
Unit=ax-dispatch-catchup.service

[Install]
WantedBy=timers.target

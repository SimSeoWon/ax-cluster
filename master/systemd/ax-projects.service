[Unit]
Description=AX cluster project registry (MCP — 프로젝트 등록·마운트 전환)
Documentation=https://github.com/SimSeoWon/ax-cluster
# 설정과 디지털 트윈 디렉토리가 로컬 디스크에 있다.
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
Type=simple
User=sim
Group=sim
WorkingDirectory=/home/sim/ax-cluster

# 🔴 폴백 없음 — 루트를 역산하지 않는다 (PLAN §5.5.3-④).
# 🔴 상용 CLI(`agy`·`claude`)는 `~/.local/bin` 에 있고 systemd 기본 PATH 에는 그 경로가 없다.
# 실측 2026-08-13: 웹 게시판의 도메인 생성이 *"LLM 을 못 불러"* 로 떨어졌다 — 코드가 아니라
# **유닛 환경** 문제였다(`shutil.which` 가 못 찾는다). SSH 세션의 PATH 함정과 같은 부류다.
Environment=PATH=/home/sim/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=AX_PROJECTS_ROOT=/home/sim/ax-cluster
Environment=AX_PROJECTS_HOST=0.0.0.0
Environment=AX_PROJECTS_PORT=8103
Environment=PYTHONUNBUFFERED=1

ExecStart=/home/sim/ax-cluster/.venv/bin/python -m master.projects

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ax-projects

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# projects.yaml 과 각 프로젝트 디렉토리를 쓴다. bare 저장소는 읽기만 한다.
ProtectHome=false
ReadWritePaths=/home/sim/ax-cluster

[Install]
WantedBy=multi-user.target

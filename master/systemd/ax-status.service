[Unit]
# 🔴 클러스터 상태 스냅샷을 **주기적으로** 다시 만든다.
#
# 왜 있나 (사용자 지적 2026-08-13: *"지금 70분째 갱신 안되는데?"*):
#   `/cluster` 는 **마지막으로 생성된 파일**을 보여준다 — 페이지를 새로 고쳐도 수집은 일어나지
#   않는다(그게 `MIN_INTERVAL` 120초 가드의 목적이다: 브라우저 새로고침이 SSH 폭풍이 되면 안 된다).
#   그래서 갱신은 **요청이 아니라 타이머**가 해야 한다. 없으면 화면은 영원히 낡는다.
#
# ⚠️ 이 유닛은 **읽기만** 한다: 각 머신에 `ssh -o BatchMode=yes` 로 붙어 온도·전력·상주 모델·
#    커밋을 읽고, 로컬에서 `systemctl is-active` 를 본다. **쓰는 명령은 없다.**
#    `.33` 은 사람의 작업 PC 다 — 그쪽에도 읽기 전용 조회만 나간다.
#
# ⚠️ 머신이 꺼져 있어도 매달리지 않는다 — `ConnectTimeout` 이 걸려 있고, 응답 없는 머신은
#    화면에 "응답 없음" 으로 적힌다(조용히 빠뜨리지 않는다).
Description=AX 클러스터 상태 스냅샷 생성
After=network-online.target ax-projects.service
Wants=network-online.target

[Service]
Type=oneshot
User=sim
WorkingDirectory=/home/sim/ax-cluster
# 🔴 유닛의 PATH 에는 `~/.local/bin` 이 없다 — 실측으로 물린 자리다(ax-projects 도 같은 이유로 고쳤다)
Environment=PATH=/home/sim/.local/bin:/usr/local/bin:/usr/bin:/bin
# 🔴 `AX_PROJECTS_ROOT` 는 **폴백이 없다**(PLAN §5.5.3-④, fail-closed). 없으면 유닛이 죽는다 —
#    실제로 첫 실행이 이것 때문에 죽었고, 그게 설계 의도대로 동작한 것이다. `ax-projects.service`
#    와 **같은 값**이어야 한다: 두 유닛이 서로 다른 프로젝트를 보면 화면과 API 가 갈린다.
Environment=AX_PROJECTS_ROOT=/home/sim/ax-cluster
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/sim/ax-cluster/.venv/bin/python -m master.status html
# 수집이 오래 걸려도 다음 타이머와 겹치지 않게 끊는다 (실측 수집 시간은 10초 내외)
TimeoutStartSec=90
# 🔴 종료코드 3 = `status.EXIT_TOO_SOON` — **최소 간격 가드에 걸려 수집을 건너뛴 것**이고 고장이 아니다.
#    사람이 손으로 `python -m master.status html` 을 돌린 직후에 타이머가 뜨면 반드시 여기 걸린다.
#    이걸 실패로 남기면 `systemctl status` 의 빨간 글씨가 무의미해진다(실측 2026-08-13).
#    ⚠️ 1 은 여기 넣지 않는다 — 진짜 실패는 실패로 보여야 한다.
SuccessExitStatus=3

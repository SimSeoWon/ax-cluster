[Unit]
Description=AX 분산 작업 완료 후속 — 라운드 종결 시 ⑦ 준비 (#798, confirm=False)
Documentation=https://github.com/SimSeoWon/ax-cluster
# 🔴 폴링 데몬이 아니다. 타이머가 깨우고 한 번 훑고 끝난다 (ax-review-queue 와 같은 형태).
#
# 🔴 [중요] **수신의 바닥이다** (사용자 결정 2026-10-11, #798): 지휘자가 Claude 든 Codex 든,
#    세션이 꺼져 있든, 라운드가 종결되면 1분 안에 같은 공통 핵심(`master.work.followup`)이
#    ⑦ 를 준비한다. 🔴 **이 타이머가 유일한 수신자다** — 마스터에서는 훅을 쓰지 않는다
#    (사용자 결정 2026-10-11). 사람이 같은 CLI 를 직접 불러도 followup 의 잠금으로 겹치지 않는다.
#    [주의] 하는 일은 `advance_work(confirm=False)` 까지다 — push 없음 · `main` 무관 ·
#    전진과 finalize 는 사람의 승인이 트리거다. 그래서 삭제된 「통합자」의 부활이 아니다
#    (그것은 서버가 durable 에 머지했다).
After=network-online.target local-fs.target ax-task-queue.service
Wants=network-online.target

[Service]
Type=oneshot
User=sim
Group=sim

WorkingDirectory=/home/sim/ax-cluster
Environment=AX_PROJECTS_ROOT=/home/sim/ax-cluster
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/sim/.local/bin:/usr/local/bin:/usr/bin:/bin

# 🔴 AXCluster 의 요청자는 마스터이고, 정본은 마스터 클론 `/home/sim/ax-cluster` 그 자체다
#    (별도 요청자 클론 없음). 격리 worktree 는 그 옆에 세워지고 정본 트리는 건드리지 않는다.
#    `--project` 를 명시한다 — 마운트가 바뀌어도 이 요청자의 work 를 놓치지 않게.
#    `--python` 은 통합 검사·회귀를 돌릴 저장소 venv 다.
ExecStart=/home/sim/ax-cluster/.venv/bin/python -m master.work.followup --scan --project AXCluster --repo /home/sim/ax-cluster --python /home/sim/ax-cluster/.venv/bin/python

# 한 회차가 라운드 하나를 준비하면 공식 통합 검사(실측 ≈64초)와 회귀가 돈다. 여유를 둔다.
# 실행 중에는 타이머가 다음 회차를 겹쳐 띄우지 않는다(oneshot 활성 중).
TimeoutStartSec=1800

# 🔴 라운드 하나의 준비 실패는 followup 상태·로그·Redmine 노트에 남고 유닛을 붉히지 않는다.
#    유닛이 붉어지는 것은 훑기 자체가 안 된 경우(큐 조회 실패·프로젝트 미상)뿐이다 —
#    그것은 수신의 바닥이 죽은 것이라 보여야 한다. 기록: `~/.cache/ax-followup/followup.jsonl` · journal.

Nice=10

[Install]
WantedBy=multi-user.target

[Unit]
Description=AX cluster task_queue (job distribution + claim/lease/fencing)
Documentation=https://github.com/SimSeoWon/ax-cluster
# 감사 커밋이 로컬 git 저장소를 쓰므로 파일시스템이 준비된 뒤에 뜬다.
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
Type=simple
User=sim
Group=sim
WorkingDirectory=/home/sim/ax-cluster

# 큐 상태 루트. MCP stdio 모드가 이 값으로 루트를 잡는다(미설정이면 즉시 실패 —
# 원본의 "파일 위치 역산" 폴백을 의도적으로 없앴다. PLAN.md §9.5).
Environment=AX_TASK_QUEUE_ROOT=/home/sim/ax-state
Environment=AX_PROJECTS_ROOT=/home/sim/ax-cluster
Environment=PYTHONUNBUFFERED=1

# --serve <state_root> [port] [host]
ExecStart=/home/sim/ax-cluster/.venv/bin/python -m master.task_queue --serve /home/sim/ax-state 8101 0.0.0.0

Restart=always
RestartSec=5

# 원본이 손으로 하던 수명주기 관리를 systemd 가 가져간다 (PLAN.md §5.4.3):
#   자식 프로세스 .poll() 생존 감시 → Restart=always
#   Job Object 고아 정리(Windows 전용) → cgroup (KillMode=control-group 기본)
#   로그 파일 관리 → journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ax-task-queue

# 최소 권한.
# [주의] 종전 주석은 *"쓰는 곳은 상태 저장소 하나뿐"* 이라고 했으나 **낡았다** — 큐는 트윈에도
#    쓴다(신호 드롭박스 #206, 시소러스 대행 #243). 그때마다 경로가 손으로 늘어 저장소 사본과
#    실물이 어긋났다(실측 2026-08-22: 실물에만 3줄 더 있었다).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/sim/ax-state

# [중요] **트윈 루트를 열고, 코드를 읽기 전용으로 못박는다** (#276, 2026-08-22).
#    종전에는 `ReadWritePaths=…/ModularStage/recipes` 처럼 **프로젝트 이름이 유닛에 박혀** 있었다.
#    그래서 ⓐ 표면을 늘릴 때마다 손으로 추가해야 했고 — 그래서 `ontology/` 가 빠져 **시소러스
#    대행이 처음부터 500 이었다**(마운트된 프로젝트조차 실패했다) ⓑ 새 프로젝트(NS)는 애초에
#    불가능했다. 다중 프로젝트 축(§12)과 정면으로 어긋난다.
#    [주의] `ReadWritePaths` 에 글롭이 없으므로 `<루트>/<프로젝트>/` 를 나열할 방법이 없다 →
#    루트를 열고 **트윈이 아닌 것을 전부 되돌린다.** 새 트윈은 자동으로 포함된다.
ProtectHome=false
ReadWritePaths=/home/sim/ax-cluster

# [중요] `#206` 의 의도(*"큐가 저장소 코드를 쓸 수 있게 되면 안 된다"*)를 **여기서** 지킨다 —
#    경로를 좁히는 대신 코드·문서·git 을 읽기 전용으로 되돌린다. 트윈(`ModularStage/`·`NS/`)만
#    쓰기로 남는다. [주의] **트윈이 아닌 최상위 항목을 추가하면 이 목록에도 넣어야 한다.**
ReadOnlyPaths=/home/sim/ax-cluster/master
ReadOnlyPaths=/home/sim/ax-cluster/client
ReadOnlyPaths=/home/sim/ax-cluster/worker
ReadOnlyPaths=/home/sim/ax-cluster/docs
ReadOnlyPaths=/home/sim/ax-cluster/machines
ReadOnlyPaths=/home/sim/ax-cluster/reports
ReadOnlyPaths=/home/sim/ax-cluster/ax-exports
ReadOnlyPaths=/home/sim/ax-cluster/.git
ReadOnlyPaths=/home/sim/ax-cluster/PLAN.md
ReadOnlyPaths=/home/sim/ax-cluster/README.md
ReadOnlyPaths=/home/sim/ax-cluster/CLAUDE.md
ReadOnlyPaths=/home/sim/ax-cluster/projects.yaml
# [주의] `-` 접두사 = **없으면 무시**. 이 파일은 벤치 산출물이라 지워질 수 있고,
#    그때 유닛이 뜨지 못하면 안 된다(`ReadOnlyPaths` 는 없는 경로에 기동을 실패한다).
ReadOnlyPaths=-/home/sim/ax-cluster/bench_skeleton_result.json
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target

# AX 유닛 조작 (`#647` 재시작 · `#360` 복구). **판정은 helper 가 한다** — 이 표는
# 명령줄을 글자로 맞추는 2차 방어다.
# [중요] 재시작은 **1인자 형태만** 연다(`<helper> ax-task-queue`). helper 는 대칭을
#   위해 `restart <unit>` 도 받지만 그 줄은 여기 없다 — 넓히려면 여기를 고쳐야 한다.
# [주의] `reset-failed` 는 상태만 지운다(무엇도 기동하지 않는다). 그래서 `.path`·
#   `.timer` 까지 연다 — `#360` 사고에서 죽은 것이 `.service` 와 `.path` 둘 다였다.
sim ALL=(root) NOPASSWD: /usr/local/sbin/ax-service-restart-root ax-task-queue, /usr/local/sbin/ax-service-restart-root ax-projects, /usr/local/sbin/ax-service-restart-root ax-broker, /usr/local/sbin/ax-service-restart-root ax-indexer, /usr/local/sbin/ax-service-restart-root ax-batch, /usr/local/sbin/ax-service-restart-root ax-status, /usr/local/sbin/ax-service-restart-root ax-dispatch, /usr/local/sbin/ax-service-restart-root ax-review-queue, /usr/local/sbin/ax-service-restart-root reset-failed ax-task-queue, /usr/local/sbin/ax-service-restart-root reset-failed ax-task-queue.service, /usr/local/sbin/ax-service-restart-root reset-failed ax-task-queue.path, /usr/local/sbin/ax-service-restart-root reset-failed ax-task-queue.timer, /usr/local/sbin/ax-service-restart-root reset-failed ax-projects, /usr/local/sbin/ax-service-restart-root reset-failed ax-projects.service, /usr/local/sbin/ax-service-restart-root reset-failed ax-projects.path, /usr/local/sbin/ax-service-restart-root reset-failed ax-projects.timer, /usr/local/sbin/ax-service-restart-root reset-failed ax-broker, /usr/local/sbin/ax-service-restart-root reset-failed ax-broker.service, /usr/local/sbin/ax-service-restart-root reset-failed ax-broker.path, /usr/local/sbin/ax-service-restart-root reset-failed ax-broker.timer, /usr/local/sbin/ax-service-restart-root reset-failed ax-indexer, /usr/local/sbin/ax-service-restart-root reset-failed ax-indexer.service, /usr/local/sbin/ax-service-restart-root reset-failed ax-indexer.path, /usr/local/sbin/ax-service-restart-root reset-failed ax-indexer.timer, /usr/local/sbin/ax-service-restart-root reset-failed ax-batch, /usr/local/sbin/ax-service-restart-root reset-failed ax-batch.service, /usr/local/sbin/ax-service-restart-root reset-failed ax-batch.path, /usr/local/sbin/ax-service-restart-root reset-failed ax-batch.timer, /usr/local/sbin/ax-service-restart-root reset-failed ax-status, /usr/local/sbin/ax-service-restart-root reset-failed ax-status.service, /usr/local/sbin/ax-service-restart-root reset-failed ax-status.path, /usr/local/sbin/ax-service-restart-root reset-failed ax-status.timer, /usr/local/sbin/ax-service-restart-root reset-failed ax-dispatch, /usr/local/sbin/ax-service-restart-root reset-failed ax-dispatch.service, /usr/local/sbin/ax-service-restart-root reset-failed ax-dispatch.path, /usr/local/sbin/ax-service-restart-root reset-failed ax-dispatch.timer, /usr/local/sbin/ax-service-restart-root reset-failed ax-dispatch-catchup, /usr/local/sbin/ax-service-restart-root reset-failed ax-dispatch-catchup.service, /usr/local/sbin/ax-service-restart-root reset-failed ax-dispatch-catchup.path, /usr/local/sbin/ax-service-restart-root reset-failed ax-dispatch-catchup.timer, /usr/local/sbin/ax-service-restart-root reset-failed ax-review-queue, /usr/local/sbin/ax-service-restart-root reset-failed ax-review-queue.service, /usr/local/sbin/ax-service-restart-root reset-failed ax-review-queue.path, /usr/local/sbin/ax-service-restart-root reset-failed ax-review-queue.timer

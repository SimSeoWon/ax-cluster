[Unit]
Description=AX 클러스터 유휴 배치 주기 확인 (시간 게이트가 실제 실행을 정한다)

[Timer]
# 🔴 **이 타이머는 「돌릴 때」를 정하지 않는다 — 「확인할 때」를 정한다.**
# 실제 실행 여부는 원전에서 옮겨온 시간 게이트가 판정한다(요일·시각·최소 입력·최소 간격).
# 그래서 타이머를 자주 깨워도 배치가 자주 도는 것이 아니다 — 게이트가 막는다.
#
# 1시간을 고른 근거:
#   ① 원전 게이트의 해상도가 **시각(hour)** 단위다(`rag_analysis_hour=23`). 그보다 촘촘히
#      깨울 이유가 없고, 그보다 드물게 깨우면 지정 시각 창을 놓칠 수 있다.
#   ② 게이트 판정 자체가 싸다(로그 줄 수 세기 + 마커 파일 읽기). 헛기동 비용이 거의 0 이다.
#   ③ 🔴 진행 중 분산 작업이 있으면 즉시 물러난다(종료코드 4) — 파이프라인과 경쟁하지 않는다.
OnBootSec=15min
OnUnitActiveSec=1h
RandomizedDelaySec=5min
AccuracySec=1min
# 🔴 놓친 회차를 부팅 후 몰아서 돌리지 않는다 — 유휴 배치는 급할 것이 없고,
#    시간 게이트가 어차피 요일·시각을 본다.
Persistent=false

[Install]
WantedBy=timers.target
